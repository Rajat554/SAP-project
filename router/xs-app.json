{
  "welcomeFile": "index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/v4/wash-wizard/(.*)$",
      "target": "/odata/v4/wash-wizard/$1",
      "destination": "srv_target",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/index.html$",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/service_entries/(.*)$",
      "target": "/service-entries/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/service_records/(.*)$",
      "target": "/service-records/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
