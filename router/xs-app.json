{
  "welcomeFile": "index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/v4/wash-wizard/(.*)$",
      "target": "/odata/v4/wash-wizard/$1",
      "destination": "srv_target",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/service-entries/(.*)$",
      "target": "$1",
      "localDir": "resources/service-entries",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/service-records/(.*)$",
      "target": "$1",
      "localDir": "resources/service-records",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/analytics/(.*)$",
      "target": "$1",
      "localDir": "resources/analytics",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/catalog/(.*)$",
      "target": "$1",
      "localDir": "resources/catalog",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/admin/(.*)$",
      "target": "$1",
      "localDir": "resources/admin",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
