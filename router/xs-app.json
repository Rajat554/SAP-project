{
  "welcomeFile": "washwizard.portal/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/index.html(.*)$",
      "target": "/washwizard.portal/index.html$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/odata/v4/wash-wizard/(.*)$",
      "target": "/odata/v4/wash-wizard/$1",
      "destination": "srv_target",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
