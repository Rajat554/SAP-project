{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv_target",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "srv_target",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/index.html$",
      "target": "/index.html",
      "destination": "ui_target",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "destination": "ui_target",
      "authenticationType": "xsuaa"
    }
  ]
}