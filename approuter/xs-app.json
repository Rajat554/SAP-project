{
  "welcomeFile": "/shell/webapp/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/v4/wash-wizard/(.*)$",
      "target": "/odata/v4/wash-wizard/$1",
      "destination": "washwizard_backend_api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "localDir": "../app",
      "authenticationType": "xsuaa"
    }
  ]
}
