_schema-version: "3.2"
ID: sap-project-test
extends: sap-project

# Testing environment overrides
# Usage: cf deploy sap-project.mtar -e test.mtaext

modules:
  - name: sap-project-srv
    parameters:
      memory: 512M
      disk-quota: 512M
    properties:
      CDS_ENV: testing

  - name: sap-project-db-deployer
    parameters:
      memory: 256M
      disk-quota: 512M
    properties:
      CDS_ENV: testing
