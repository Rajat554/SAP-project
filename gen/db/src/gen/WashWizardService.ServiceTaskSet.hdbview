VIEW WashWizardService_ServiceTaskSet AS SELECT
  ServiceTask_0.ID,
  ServiceTask_0.createdAt,
  ServiceTask_0.createdBy,
  ServiceTask_0.modifiedAt,
  ServiceTask_0.modifiedBy,
  ServiceTask_0.CustomerName,
  ServiceTask_0.Phone,
  ServiceTask_0.CarModel,
  ServiceTask_0.VehiclePlate,
  ServiceTask_0.ServiceType,
  ServiceTask_0.Amount,
  ServiceTask_0.PaymentMethod,
  ServiceTask_0.Status,
  ServiceTask_0.ServiceDate,
  ServiceTask_0.CompletedAt,
  ServiceTask_0.HandledBy,
  1 AS ServiceCount,
  ServiceTask_0.Amount AS AvgAmount,
  ServiceTask_0.Amount AS AvgDailyAmount
FROM WashWizard_ServiceTask AS ServiceTask_0