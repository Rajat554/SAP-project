COLUMN TABLE WashWizardService_ServiceTaskSet_drafts (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP NULL,
  createdBy NVARCHAR(255) NULL,
  modifiedAt TIMESTAMP NULL,
  modifiedBy NVARCHAR(255) NULL,
  CustomerName NVARCHAR(100) NULL,
  Phone NVARCHAR(10) NULL,
  CarModel NVARCHAR(100) NULL,
  VehiclePlate NVARCHAR(20) NULL,
  ServiceType NVARCHAR(500) NULL,
  Amount DECIMAL(10, 2) NULL,
  PaymentMethod NVARCHAR(20) NULL DEFAULT 'Online',
  Status NVARCHAR(20) NULL DEFAULT 'Pending',
  ServiceDate DATE NULL,
  CompletedAt DATE NULL,
  HandledBy NVARCHAR(50) NULL,
  ServiceCount INTEGER NULL,
  AvgAmount DECIMAL(10, 2) NULL,
  AvgDailyAmount DECIMAL(10, 2) NULL,
  IsActiveEntity BOOLEAN,
  HasActiveEntity BOOLEAN,
  HasDraftEntity BOOLEAN,
  DraftAdministrativeData_DraftUUID NVARCHAR(36) NOT NULL,
  PRIMARY KEY(ID)
)