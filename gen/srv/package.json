{
  "name": "sap-project",
  "version": "2.0.0",
  "description": "WashWizard — Fiori Elements Edition",
  "license": "ISC",
  "author": "Rajat Patel",
  "scripts": {
    "start": "cds serve",
    "watch": "cds watch"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds-dk": "^9",
    "@sap/ux-specification": "^1.120.16"
  },
  "cds": {
    "requires": {
      "db": "sqlite",
      "auth": {
        "kind": "mocked",
        "users": {
          "admin": {
            "password": "admin123",
            "roles": [
              "Admin"
            ]
          },
          "staff": {
            "password": "staff123",
            "roles": [
              "Staff"
            ]
          }
        }
      }
    },
    "[production]": {
      "requires": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "sapux": [
    "app/service-entries",
    "app/service-records",
    "app/analytics",
    "app/admin"
  ],
  "engines": {
    "node": ">=20"
  }
}