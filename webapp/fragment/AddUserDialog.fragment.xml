<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog title="Add New User" id="idAddUserDialog" contentWidth="400px">
        <content>
            <VBox class="sapUiSmallMargin">
                <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                    <f:content>
                        <Label text="Username" required="true" />
                        <Input id="idNewUsernameInput" placeholder="Enter username" />
                        <Label text="Password" required="true" />
                        <Input id="idNewPasswordInput" type="Password" placeholder="Enter password" />
                        <Label text="Role" required="true" />
                        <Select id="idNewRoleSelect" selectedKey="Staff">
                            <core:Item key="Staff" text="Staff" />
                            <core:Item key="Admin" text="Admin" />
                        </Select>
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
        <beginButton>
            <Button text="Save" type="Emphasized" press=".onSaveButtonPress" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelButtonPress" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
