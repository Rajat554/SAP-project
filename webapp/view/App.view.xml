<mvc:View controllerName="sap.ui.demo.walkthrough.controller.App"
  xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <App id="idRootApp">

    
    <Page id="idLoginPage" title="WashWizard Login" showHeader="false" class="dashboardBackground">
      <VBox alignContent="Center" alignItems="Center" justifyContent="Center" height="100%">
        <Panel class="customPanel sapUiResponsiveMargin" width="400px">
          <VBox alignItems="Center" class="sapUiSmallMarginBottom">
            <core:Icon src="sap-icon://car-rental" size="3rem" color="#0070F2" class="sapUiSmallMarginBottom"/>
            <Title text="WashWizard" class="brandTitle" level="H2" />
            <Text text="Please login to continue" class="sapUiTinyMarginTop"/>
          </VBox>
          <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
            <f:content>
              <Label text="Username" />
              <Input id="idLoginUsernameInput" placeholder="Enter your username" />
              <Label text="Password" />
              <Input id="idLoginPasswordInput" type="Password" placeholder="Enter your password" submit=".onInputSubmit" />
            </f:content>
          </f:SimpleForm>
          <Button text="Login" type="Emphasized" width="100%" press=".onLoginButtonPress" class="sapUiMediumMarginTop customSaveBtn"/>
        </Panel>
      </VBox>
    </Page>

    
    <Page id="idMainPage" showHeader="false">
      <tnt:ToolPage id="idAppToolPage">
        <tnt:header>
          <tnt:ToolHeader>
            <Button id="idSideNavigationToggleButton" icon="sap-icon://menu2" type="Transparent" press=".onButtonSideNavPress" tooltip="Toggle Menu">
              <layoutData>
                <OverflowToolbarLayoutData priority="NeverOverflow" />
              </layoutData>
            </Button>
            
            <HBox alignItems="Center">
              <layoutData>
                <OverflowToolbarLayoutData priority="NeverOverflow" />
              </layoutData>
              <core:Icon src="sap-icon://car-rental" size="1.25rem" class="sapUiTinyMarginEnd icon123" color="#0070F2" />
              <VBox class="sapUiTinyMarginBegin">
                <Title text="WashWizard" class="brandTitle" />
              </VBox>
            </HBox>
            <ToolbarSpacer />
            
            <HBox alignItems="Center" class="sapUiSmallMarginEnd">
              <layoutData>
                <OverflowToolbarLayoutData priority="NeverOverflow" />
              </layoutData>
              <Avatar press=".onAvatarPress" initials="{= ${userModel>/username} ? ${userModel>/username}.charAt(0).toUpperCase() : 'U'}" displaySize="XS" class="sapUiTinyMarginEnd" />
              <VBox class="hiddenOnSmall">
                <Text text="{userModel>/username} ({userModel>/role})" class="userNameText" />
              </VBox>
            </HBox>
          </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
          <tnt:SideNavigation id="idAppSideNavigation" itemSelect=".onSideNavigationItemSelect">
            <tnt:NavigationList>
              <tnt:NavigationListItem text="Dashboard" icon="sap-icon://bbyd-dashboard" key="dashboard" />
              <tnt:NavigationListItem text="Customers" icon="sap-icon://customer" key="customers" />
              <tnt:NavigationListItem text="Service Records" icon="sap-icon://form" key="records" />
              <tnt:NavigationListItem text="Analytics" icon="sap-icon://business-objects-experience" key="analytics" />
              <tnt:NavigationListItem text="Settings" icon="sap-icon://action-settings" key="settings" visible="{= ${userModel>/role} === 'Admin' }" />
            </tnt:NavigationList>
          </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
          <App id="idContentApp" />
        </tnt:mainContents>
      </tnt:ToolPage>
    </Page>
  </App>
</mvc:View>
