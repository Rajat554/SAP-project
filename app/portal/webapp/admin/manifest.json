{
  "_version": "1.65.0",
  "sap.app": {
    "id": "washwizard.admin",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "User Management",
    "description": "Manage users and roles",
    "crossNavigation": {
      "inbounds": {
        "manage-users": {
          "semanticObject": "Users",
          "action": "manage",
          "title": "User Management",
          "icon": "sap-icon://group"
        }
      }
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/wash-wizard/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://action-settings"
    },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.cloud": {
    "public": true,
    "service": "washwizardservice"
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "admin.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "UsersSetList",
          "target": "UsersSetList"
        },
        {
          "pattern": "UsersSet({key}):?query:",
          "name": "UsersSetObjectPage",
          "target": "UsersSetObjectPage"
        }
      ],
      "targets": {
        "UsersSetList": {
          "type": "Component",
          "id": "UsersSetList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/UsersSet",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "UsersSet": {
                  "detail": { "route": "UsersSetObjectPage" }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "personalization": true
                  }
                }
              }
            }
          }
        },
        "UsersSetObjectPage": {
          "type": "Component",
          "id": "UsersSetObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/UsersSet"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
