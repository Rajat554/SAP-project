{
  "_version": "1.65.0",
  "sap.app": {
    "id": "washwizard.shell.analytics",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "Revenue Analytics",
    "description": "Analyze revenue trends, service type distribution, and staff performance",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/wash-wizard/",
        "type": "OData",
        "settings": { "annotations": [], "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.cloud": { "public": true, "service": "washwizard" },
  "sap.ui5": {
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ui.fl": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "AnalyticsList",
          "target": "AnalyticsList"
        },
        {
          "pattern": "ServiceTaskSet({key}):?query:",
          "name": "AnalyticsDetail",
          "target": "AnalyticsDetail"
        }
      ],
      "targets": {
        "AnalyticsList": {
          "type": "Component",
          "id": "AnalyticsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ServiceTaskSet",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "keyPerformanceIndicators": {
                "KPI_TotalRevenue": {
                  "entitySet": "ServiceTaskSet",
                  "qualifier": "TotalRevenue"
                },
                "KPI_TotalServices": {
                  "entitySet": "ServiceTaskSet",
                  "qualifier": "TotalServices"
                },
                "KPI_AvgDailyRevenue": {
                  "entitySet": "ServiceTaskSet",
                  "qualifier": "AvgDailyRevenue"
                },
                "KPI_AvgServiceValue": {
                  "entitySet": "ServiceTaskSet",
                  "qualifier": "AvgServiceValue"
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "DailyOverview",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#RevenueTrends",
                    "label": "Daily Overview"
                  },
                  {
                    "key": "ServiceTypeDistribution",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#ServiceDistribution",
                    "label": "Service Type Distribution"
                  },
                  {
                    "key": "RevenueByStaffMember",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Performance",
                    "label": "Revenue by Staff Member"
                  }
                ]
              },
              "navigation": {
                "ServiceTaskSet": {
                  "detail": {
                    "route": "AnalyticsDetail"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "enableExport": true,
                    "personalization": true,
                    "condensedTableLayout": true
                  }
                }
              }
            }
          }
        },
        "AnalyticsDetail": {
          "type": "Component",
          "id": "AnalyticsDetail",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ServiceTaskSet"
            }
          }
        }
      }
    }
  },
  "sap.fiori": { "registrationIds": [], "archeType": "analytical" }
}
