<mvc:View
    controllerName="washwizard.app.shell.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    displayBlock="true"
    height="100%">
    <App id="idApp">
        <pages>
            <Page id="idShellPage" showHeader="false">
                <tnt:ToolPage id="idToolPage">
                    <tnt:header>
                        <tnt:ToolHeader>
                            <Button id="idSideNavigationToggleButton"
                                    icon="sap-icon://menu2"
                                    type="Transparent"
                                    press=".onButtonCollapseExpandPress">
                                <layoutData>
                                    <OverflowToolbarLayoutData priority="NeverOverflow" />
                                </layoutData>
                            </Button>
                            <ToolbarSpacer width="20px" />
                            <Title text="WashWizard" level="H1" />
                            <tnt:ToolHeaderUtilitySeparator />
                            <ToolbarSpacer />
                            <SearchField id="idSearchField" width="200px" placeholder="Search..." />
                            <ToolbarSpacer width="20px" />
                            <Button id="idNotificationButton" icon="sap-icon://bell" type="Transparent" />
                            <Button id="idHelpButton" icon="sap-icon://sys-help" type="Transparent" />
                            <Avatar id="idUserAvatar" displaySize="XS" src="sap-icon://customer" />
                        </tnt:ToolHeader>
                    </tnt:header>
                    <tnt:sideContent>
                        <tnt:SideNavigation id="idSideNavigation">
                            <tnt:item>
                                <tnt:NavigationList id="idNavigationList" itemSelect=".onNavigationListItemSelect" selectedKey="records">
                                    <tnt:NavigationListItem text="Service Records" icon="sap-icon://request" key="records" />
                                    <tnt:NavigationListItem text="Service Entries" icon="sap-icon://add-document" key="entries" />
                                    <tnt:NavigationListItem text="Analytics" icon="sap-icon://pie-chart" key="analytics" />
                                    <tnt:NavigationListItem text="Catalog" icon="sap-icon://list" key="catalog" />
                                    <tnt:NavigationListItem text="Admin" icon="sap-icon://action-settings" key="admin" />
                                </tnt:NavigationList>
                            </tnt:item>
                        </tnt:SideNavigation>
                    </tnt:sideContent>
                    <tnt:mainContents>
                        <Page id="idMainContentsPage" showHeader="false" />
                    </tnt:mainContents>
                </tnt:ToolPage>
            </Page>
        </pages>
    </App>
</mvc:View>
