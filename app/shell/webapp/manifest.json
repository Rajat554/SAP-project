{
  "_version": "1.49.0",
  "sap.app": {
    "id": "washwizard.app.shell",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "WashWizard Dashboard",
    "description": "Master Dashboard for WashWizard",
    "crossNavigation": {
      "inbounds": {
        "intent1": {
          "semanticObject": "washwizard",
          "action": "display",
          "title": "WashWizard Dashboard",
          "icon": "sap-icon://home"
        }
      }
    }
  },
  "sap.cloud": { "public": true, "service": "washwizard" },
  "sap.ui": {
    "technology": "UI5",
    "icons": { "icon": "sap-icon://home" },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {},
        "sap.tnt": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "washwizard.app.shell.i18n.i18n" }
      }
    },
    "rootView": {
      "viewName": "washwizard.app.shell.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}
