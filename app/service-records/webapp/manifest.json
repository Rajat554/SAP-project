{
  "_version": "1.65.0",
  "sap.app": {
    "id": "washwizard.app.service-records",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "Service Records",
    "description": "View historical records of services performed",
    "crossNavigation": {
      "inbounds": {
        "view-records": {
          "semanticObject": "ServiceRecords",
          "action": "view",
          "title": "Service Records",
          "icon": "sap-icon://history",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/wash-wizard/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://list"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "washwizard"
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "service-records.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ServiceRecordsList",
          "target": "ServiceRecordsList"
        },
        {
          "pattern": "ServiceTaskSet({key}):?query:",
          "name": "ServiceRecordDetail",
          "target": "ServiceRecordDetail"
        }
      ],
      "targets": {
        "ServiceRecordsList": {
          "type": "Component",
          "id": "ServiceRecordsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ServiceTaskSet",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "ServiceTaskSet": {
                  "detail": {
                    "route": "ServiceRecordDetail"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "enableExport": true,
                    "personalization": true,
                    "condensedTableLayout": true,
                    "growing": true,
                    "growingThreshold": 25
                  }
                }
              }
            }
          }
        },
        "ServiceRecordDetail": {
          "type": "Component",
          "id": "ServiceRecordDetail",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ServiceTaskSet"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}